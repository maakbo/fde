{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fde/design-preparation/review-findings.schema.json",
  "title": "Review finding draft SCHEMA-v2",
  "description": "Synthetic design exercise only. Valid structure does not establish evidence, acceptance, approval, or permission to act.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "status",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SCHEMA-v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "draft"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source_ids",
          "evidence",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "missing_version",
              "version_conflict",
              "open_question"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "source_id",
              "field",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "enum": [
                  "version",
                  "text"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "field": {
                      "const": "text"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
