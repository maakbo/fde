{
  "name": "maakbo-fde",
  "version": "0.2.0",
  "private": true,
  "description": "A portable agent environment for forward-deployed business modeling and discussion-ready diagrams.",
  "license": "MIT",
  "scripts": {
    "validate": "python3 scripts/validate_repository.py",
    "export:overview": "python3 .agents/skills/mermaid-diagram-export/scripts/export_mermaid.py examples/system-development/README.md --type context --diagram 1",
    "export:context": "python3 .agents/skills/mermaid-diagram-export/scripts/export_mermaid.py examples/system-development/README.md --type context --diagram 1",
    "export:flow": "python3 .agents/skills/mermaid-diagram-export/scripts/export_mermaid.py examples/system-development/implementation/README.md --type flow",
    "export:examples": "npm run export:overview && npm run export:flow"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0"
  },
  "allowScripts": {
    "puppeteer@25.9.0": true
  }
